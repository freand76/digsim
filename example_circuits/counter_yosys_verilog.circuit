{
    "circuit": {
        "name": "DigSimCircuit",
        "components": [
            {
                "name": "counter",
                "type": "digsim.circuit.components.YosysComponent",
                "display_name": "counter",
                "settings": {
                    "path": "../examples/yosys_counter/counter.v"
                }
            },
            {
                "name": "Clock_1",
                "type": "digsim.circuit.components.Clock",
                "display_name": "Clock",
                "settings": {
                    "frequency": 5
                }
            },
            {
                "name": "PushButton_2",
                "type": "digsim.circuit.components.PushButton",
                "display_name": "PushButton",
                "settings": {}
            },
            {
                "name": "HexDigit_4",
                "type": "digsim.circuit.components.HexDigit",
                "display_name": "HexDigit",
                "settings": {
                    "digits": 1,
                    "dot": true
                }
            },
            {
                "name": "OnOffSwitch",
                "type": "digsim.circuit.components.OnOffSwitch",
                "display_name": "OnOffSwitch",
                "settings": {}
            },
            {
                "name": "Led",
                "type": "digsim.circuit.components.Led",
                "display_name": "Led",
                "settings": {}
            },
            {
                "name": "Note",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "The counter component is a \"Netlist-component\" \ngenerated from verilog with the Yosys synthesis tool."
                }
            },
            {
                "name": "Note_1",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "Start simulation by pressing the \"Start Simulation\" button above..."
                }
            },
            {
                "name": "Note_2",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "Enable the counter with this switch\nUse shortcut key 2 to toggle."
                }
            },
            {
                "name": "Note_3",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "This push-button will reset the counter\nUse shortcut key 1 to push."
                }
            },
            {
                "name": "Note_4",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "This is a clock generator, \nThe clock frequency can be changed,\n\"right-click\" and select \"Settings\""
                }
            },
            {
                "name": "Note_5",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "This LED will light up when the clock is High"
                }
            },
            {
                "name": "Note_6",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "This hex-digit will show the current counter value"
                }
            },
            {
                "name": "LogicAnalyzer",
                "type": "digsim.circuit.components.LogicAnalyzer",
                "display_name": "LogicAnalyzer",
                "settings": {
                    "sample_rate": 20
                }
            },
            {
                "name": "Bus2Wires",
                "type": "digsim.circuit.components.Bus2Wires",
                "display_name": "Bus2Wires",
                "settings": {
                    "width": 4,
                    "enable": [
                        0,
                        1,
                        2,
                        3
                    ]
                }
            },
            {
                "name": "LabelWireIn",
                "type": "digsim.circuit.components.LabelWireIn",
                "display_name": "LabelWireIn",
                "settings": {
                    "label": "SWITCH",
                    "width": 1
                }
            },
            {
                "name": "LabelWireIn_1",
                "type": "digsim.circuit.components.LabelWireIn",
                "display_name": "LabelWireIn",
                "settings": {
                    "label": "BUTTON",
                    "width": 1
                }
            },
            {
                "name": "LabelWireIn_2",
                "type": "digsim.circuit.components.LabelWireIn",
                "display_name": "LabelWireIn",
                "settings": {
                    "label": "CLOCK",
                    "width": 1
                }
            },
            {
                "name": "LabelWireOut",
                "type": "digsim.circuit.components.LabelWireOut",
                "display_name": "LabelWireOut",
                "settings": {
                    "label": "CLOCK",
                    "width": 1
                }
            },
            {
                "name": "LabelWireOut_1",
                "type": "digsim.circuit.components.LabelWireOut",
                "display_name": "LabelWireOut",
                "settings": {
                    "label": "BUTTON",
                    "width": 1
                }
            },
            {
                "name": "LabelWireOut_2",
                "type": "digsim.circuit.components.LabelWireOut",
                "display_name": "LabelWireOut",
                "settings": {
                    "label": "SWITCH",
                    "width": 1
                }
            },
            {
                "name": "Note_7",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "A Logic Analyzer showing a live \nview of the connected signals"
                }
            },
            {
                "name": "Buzzer",
                "type": "digsim.circuit.components.Buzzer",
                "display_name": "Buzzer",
                "settings": {
                    "tone": "A"
                }
            },
            {
                "name": "LabelWireOut_3",
                "type": "digsim.circuit.components.LabelWireOut",
                "display_name": "LabelWireOut",
                "settings": {
                    "label": "BUTTON",
                    "width": 1
                }
            },
            {
                "name": "Note_8",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "A buzzer that will sound when the button is pressed."
                }
            }
        ],
        "wires": [],
        "nets": [
            {
                "source": "counter.cnt",
                "sinks": [
                    "HexDigit_4.val",
                    "Bus2Wires.bus"
                ]
            },
            {
                "source": "Clock_1.O",
                "sinks": [
                    "counter.clk",
                    "Led.I",
                    "LabelWireIn_2.CLOCK"
                ]
            },
            {
                "source": "PushButton_2.O",
                "sinks": [
                    "counter.reset",
                    "LabelWireIn_1.BUTTON"
                ]
            },
            {
                "source": "OnOffSwitch.O",
                "sinks": [
                    "counter.up",
                    "HexDigit_4.dot",
                    "LabelWireIn.SWITCH"
                ]
            },
            {
                "source": "Bus2Wires.bus_0",
                "sinks": [
                    "LogicAnalyzer.E"
                ]
            },
            {
                "source": "Bus2Wires.bus_1",
                "sinks": [
                    "LogicAnalyzer.F"
                ]
            },
            {
                "source": "Bus2Wires.bus_2",
                "sinks": [
                    "LogicAnalyzer.G"
                ]
            },
            {
                "source": "Bus2Wires.bus_3",
                "sinks": [
                    "LogicAnalyzer.H"
                ]
            },
            {
                "source": "LabelWireOut.CLOCK",
                "sinks": [
                    "LogicAnalyzer.A"
                ]
            },
            {
                "source": "LabelWireOut_1.BUTTON",
                "sinks": [
                    "LogicAnalyzer.B"
                ]
            },
            {
                "source": "LabelWireOut_2.SWITCH",
                "sinks": [
                    "LogicAnalyzer.C"
                ]
            },
            {
                "source": "LabelWireOut_3.BUTTON",
                "sinks": [
                    "Buzzer.I"
                ]
            }
        ]
    },
    "gui": {
        "counter": {
            "x": 595,
            "y": 280,
            "z": 0
        },
        "Clock_1": {
            "x": 265,
            "y": 135,
            "z": 0
        },
