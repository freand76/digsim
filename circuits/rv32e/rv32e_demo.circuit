{
    "circuit": {
        "name": "DigSimCircuit",
        "components": [
            {
                "name": "cpu",
                "type": "digsim.circuit.components.SubCircuit",
                "display_name": "cpu:rv32e",
                "settings": {"path": "cpu.circuit"}
            },
            {
                "name": "clock",
                "type": "digsim.circuit.components.Clock",
                "display_name": "Clock",
                "settings": {"frequency": 100}
            },
            {
                "name": "reset",
                "type": "digsim.circuit.components.PushButton",
                "display_name": "PushButton",
                "settings": {}
            },
            {
                "name": "rom",
                "type": "digsim.circuit.components.ROM",
                "display_name": "ROM",
                "settings": {
                    "address_width": 14,
                    "data_width": 32,
                    "mode": "async",
                    "edge": "rising",
                    "output_enable": false,
                    "path": "rv32e_code/lcd.bin",
                    "load_address": 0
                }
            },
            {
                "name": "ram",
                "type": "digsim.circuit.components.RAM",
                "display_name": "RAM",
                "settings": {
                    "address_width": 14,
                    "data_width": 32,
                    "mode": "async_read",
                    "edge": "rising",
                    "output_enable": false,
                    "load_address": 0,
                    "byte_enable": true
                }
            },
            {
                "name": "gpio_split",
                "type": "digsim.circuit.components.Splitter",
                "display_name": "Splitter",
                "settings": {"groups": [8, 8, 8, 8], "direction": "split"}
            },
            {
                "name": "light_bits",
                "type": "digsim.circuit.components.Bus2Wires",
                "display_name": "Bus2Wires",
                "settings": {"width": 8, "enable": [0, 1, 2, 3, 4, 5, 6, 7]}
            },
            {
                "name": "light",
                "type": "digsim.circuit.components.LedBar",
                "display_name": "LedBar",
                "settings": {"width": 8, "color": "red"}
            },
            {
                "name": "pc",
                "type": "digsim.circuit.components.HexDigit",
                "display_name": "HexDigit",
                "settings": {"digits": 8, "dot": false}
            },
            {
                "name": "halted",
                "type": "digsim.circuit.components.Led",
                "display_name": "Led",
                "settings": {"color": "red"}
            },
            {
                "name": "Note_0",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "Clock, 100 Hz"}
            },
            {
                "name": "Note_1",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "Reset, key 1"}
            },
            {
                "name": "Note_2",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "GPIO bits 7:0"}
            },
            {
                "name": "Note_4",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "pc"}
            },
            {
                "name": "Note_5",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "halted (EBREAK, ECALL or a trap)"}
            },
            {
                "name": "Note_6",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "RV32E demo: the rv32e subcircuit (rv32e.circuit) with a ROM and a RAM.\nThe RAM has Byte enable, for the byte strobes of the processor's stores.\nThe ROM (lcd.hex, built from lcd.c with make) drives the HD44780 LCD in 4-bit mode\nthrough the GPIO register: bits 3:0 are D7:D4, bit 4 RS and bit 5 E.\nIt writes a line of text with a custom character, and the time since reset\n(from the timer) on the second line.\nprogram.hex, the earlier demo (a running light), can be chosen in the ROM's settings.\nStart the simulation and press Reset (key 1). Double-click the rv32e component\nto see inside it."
                }
            },
            {
                "name": "lcd",
                "type": "digsim.circuit.components.HD44780",
                "display_name": "HD44780",
                "settings": {"backlight": "green"}
            },
            {
                "name": "light_bits_1",
                "type": "digsim.circuit.components.Bus2Wires",
                "display_name": "Bus2Wires",
                "settings": {"width": 8, "enable": [0, 1, 2, 3, 4, 5, 6, 7]}
            },
            {
                "name": "light_1",
                "type": "digsim.circuit.components.LedBar",
                "display_name": "LedBar",
                "settings": {"width": 8, "color": "green"}
            },
            {
                "name": "Note_2_1",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {"text": "GPIO bits 15:8"}
            },
            {
                "name": "lcd_rw",
                "type": "digsim.circuit.components.GND",
                "display_name": "GND",
                "settings": {}
            }
        ]
    },
    "gui": {
        "cpu": {"x": 500, "y": 300, "z": 0},
        "clock": {"x": 60, "y": 355, "z": 0},
        "reset": {"x": 60, "y": 420, "z": 0},
