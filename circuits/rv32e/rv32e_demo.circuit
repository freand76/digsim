        "Note_2": {"x": 1016, "y": 574, "z": 0},
        "Note_4": {"x": 1162, "y": 789, "z": 0},
        "Note_5": {"x": 850, "y": 905, "z": 0},
        "Note_6": {"x": 60, "y": 30, "z": 0},
        "lcd": {"x": 1420, "y": 560, "z": 0},
