            },
            {
                "name": "adder",
                "type": "digsim.circuit.components.Adder",
                "display_name": "Adder",
                "settings": {"width": 32, "carry_in": false}
            },
            {
                "name": "reg",
                "type": "digsim.circuit.components.DFF",
                "display_name": "DFF",
                "settings": {"async_reset": true, "clock_enable": false, "width": 32}
            },
            {
                "name": "Note_0",
                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "Timer: a free-running 32-bit counter. It counts the rising clock edges,\ngoes from 0xFFFFFFFF to 0, and reset clears it."
                }
            }
        ]
    },
    "gui": {
