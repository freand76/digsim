                "type": "digsim.circuit.components.Note",
                "display_name": "Note",
                "settings": {
                    "text": "A traffic light, a state machine in SystemVerilog (examples/yosys_fsm).\nStart the simulation and push Reset (the upper button, or key 1) to start at red.\nThen push Request (the lower button, or key 2): red, red and yellow, green, yellow, red."
                }
            }
